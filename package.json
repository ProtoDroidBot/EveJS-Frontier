{
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "postinstall": "npm run build",
    "frontier:contracts": "node tools/frontier-contracts/export-frontier-contracts.mjs",
    "frontier:discover": "node tools/frontier-static/discover-frontier-client.mjs",
    "frontier:extract": "node tools/frontier-static/extract-frontier-static.mjs",
    "frontier:database": "node tools/frontier-static/build-frontier-database.mjs",
    "frontier:validate": "node tools/frontier-static/validate-frontier-static.mjs",
    "frontier:world": "pwsh -NoLogo -NoProfile -File ./FrontierWorld.ps1",
    "test:frontier-static": "node scripts/Tests/run-frontier-static-tests.js",
    "test:isolated": "node scripts/Tests/run-isolated-tests.js",
    "test:frontier-server": "node scripts/Tests/run-frontier-server-tests.js",
    "test:frontier-runners": "node --test scripts/Tests/frontier-test-files.test.js scripts/Tests/frontier-windows-runtime.test.js scripts/Tests/frontier-world-sync.test.js",
    "test:frontier-windows": "node --test scripts/Tests/frontier-windows-client.test.js scripts/Tests/frontier-windows-runtime.test.js && _local\\frontier-python312\\Scripts\\python.exe -m unittest discover -s tools/frontier-client/test -p test_*.py",
    "test:isolated-helper": "node --test server/tests/isolatedGameStore.test.js",
    "pretest": "npm run build",
    "test": "npm run test:frontier-static && npm run test:frontier-runners && npm run test:isolated-helper && npm run test:typescript-runtime",
    "test:typescript-runtime": "node --test server/tests/typescriptRuntime.test.js server/tests/frontierSuiGrpcClient.test.js server/tests/frontierSuiCharacterProvisioning.test.js && npm run test:frontier-sui-assemblies",
    "test:frontier-sui-assemblies": "node --test server/tests/frontierSuiAssembly*.test.js"
  },
  "dependencies": {
    "@mysten/sui": "^2.30.0",
    "node-forge": "^1.3.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
