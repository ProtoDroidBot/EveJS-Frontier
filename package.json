{
  "scripts": {
    "build": "npm run build:production && npm run build:tests",
    "build:production": "npm run build:server && npm run build:tools && npm run build:browser",
    "build:server": "tsc -p tsconfig.json",
    "build:tools": "tsc -p tsconfig.tools.json",
    "build:browser": "tsc -p tsconfig.browser.json",
    "build:tests": "tsc -p tsconfig.tests.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:tools && npm run typecheck:browser && npm run typecheck:tests",
    "typecheck:server": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile ./node_modules/.cache/typescript/server-typecheck.tsbuildinfo",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit --tsBuildInfoFile ./node_modules/.cache/typescript/tools-typecheck.tsbuildinfo",
    "typecheck:browser": "tsc -p tsconfig.browser.json --noEmit --tsBuildInfoFile ./node_modules/.cache/typescript/browser-typecheck.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit --tsBuildInfoFile ./node_modules/.cache/typescript/tests-typecheck.tsbuildinfo",
    "postinstall": "npm run build",
    "frontier:contracts": "node tools/frontier-contracts/export-frontier-contracts.mjs",
    "frontier:discover": "node tools/frontier-static/discover-frontier-client.mjs",
    "frontier:extract": "node tools/frontier-static/extract-frontier-static.mjs",
    "frontier:database": "node tools/frontier-static/build-frontier-database.mjs",
    "frontier:validate": "node tools/frontier-static/validate-frontier-static.mjs",
    "frontier:references": "node tools/frontier-static/audit-frontier-references.mjs",
    "frontier:world": "pwsh -NoLogo -NoProfile -File ./FrontierWorld.ps1",
    "frontier:npc:fund": "npm run build:tools && node scripts/FrontierWorld/fund-npc-factions.js",
    "frontier:npc:verify": "npm run build:tools && node scripts/Tests/verify-npc-deployment.js",
    "test:frontier-static": "node scripts/Tests/run-frontier-static-tests.js",
    "test:isolated": "node scripts/Tests/run-isolated-tests.js",
    "test:frontier-server": "node scripts/Tests/run-frontier-server-tests.js",
    "test:frontier-runners": "node --test scripts/Tests/frontier-test-files.test.js scripts/Tests/frontier-windows-runtime.test.js scripts/Tests/frontier-world-sync.test.js scripts/Tests/verify-npc-deployment.test.js",
    "test:frontier-windows": "node --test scripts/Tests/frontier-windows-client.test.js scripts/Tests/frontier-windows-runtime.test.js && _local\\frontier-python312\\Scripts\\python.exe -m unittest discover -s tools/frontier-client/test -p test_*.py",
    "test:isolated-helper": "node --test server/tests/isolatedGameStore.test.js",
    "pretest": "npm run build",
    "test": "npm run test:frontier-static && npm run test:frontier-runners && npm run test:isolated-helper && npm run test:typescript-runtime && npm run test:frontier-industry",
    "test:frontier-industry": "node scripts/Tests/run-isolated-tests.js --test-concurrency=1 server/tests/frontierIndustryProduction.test.js server/tests/frontierIndustryProductionWorker.test.js server/tests/frontierIndustryBlueprints.test.js server/tests/frontierIndustryNotifications.test.js server/tests/frontierIndustryInventoryAccess.test.js server/tests/frontierIndustryInventory.test.js server/tests/frontierIndustryStorageApi.test.js server/tests/frontierIndustryBlueprintApi.test.js server/tests/frontierIndustryBlueprintParity.test.js",
    "test:typescript-runtime": "node --test server/tests/typescriptRuntime.test.js server/tests/frontierSuiGrpcClient.test.js server/tests/frontierSuiCharacterProvisioning.test.js server/tests/frontierSuiNpcCharacterProvisioning.test.js server/tests/frontierSuiNpcFactionFunding.test.js server/tests/frontierSuiNpcIdentitySync.test.js server/tests/frontierSuiNpcWorldConfig.test.js server/tests/frontierSuiNpcProfile.test.js server/tests/frontierSuiTransponderCommitment.test.js server/tests/npcPilotIdentityStore.test.js && npm run test:frontier-sui-assemblies",
    "test:frontier-npc-identities": "node scripts/Tests/run-npc-identity-tests.js",
    "test:frontier-sui-assemblies": "node --test server/tests/frontierSuiAssembly*.test.js server/tests/frontierSuiStorage*.test.js server/tests/frontierSuiIndustry*.test.js"
  },
  "dependencies": {
    "@mysten/sui": "^2.30.0",
    "@noble/hashes": "^2.4.0",
    "node-forge": "^1.3.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
