      "label": "Digital Chemistry recipe/job client",
      "scope": "Dedicated Digital Chemistry recipe service/UI controller. Older blueprints and generic manufacturing are separate systems."
    },
    "feral_lens_trading": {
      "label": "Feral/lens trading UI",
      "scope": "Feral-network lens purchase/data-sale controller and container; excludes generic EVE item traders."
    },
    "frontier_aimed_weapons": {
      "label": "Frontier aimed weapons (prototype or full)",
      "scope": "Any audited Frontier skillshot-prototype integration/overlay OR full skillshot/held-beam/aimed-action consumers. C312-338 is a prototype generation; C355+ is the full aimed-action generation. Inherited EVE weapon/turret gameplay is excluded."
    },
    "frontier_base_building_ui": {
      "label": "Frontier placement / base building",
      "scope": "The dedicated Frontier deployment/base-building UI or consuming build/deployment service, excluding inherited EVE POS-anchor effects/services and earlier depot eligibility queries.",
      "qualification": "Absence refers to this dedicated Frontier UI generation, not all forms of anchoring in older EVE client paths."
    },
    "frontier_jump_drive": {
      "label": "Frontier jump drive",
      "scope": "Frontier jumpDriveMgr execution/map-filter/service integration, excluding inherited short-range MicroJumpDrive modules and CR micro-jump-driver component.",
      "qualification": "D2702949/2703993 means package initializers only; D2726651\u20132898485 includes common fuel-cost helper (and const in2884873), without the consuming client. C first2973163."
    },
    "frontier_scanning": {
      "label": "Frontier signature / active scan client",
      "scope": "Frontier signatures_and_scanning family. Inherited EVE probe/directional scanning modules are excluded. C requires consuming scanning_service and scanner, not only the four common modules."
    },
    "gate_iff_clients": {
      "label": "Gate/IFF",
      "scope": "Both later celestial-stargate rebuild/fuel and structure-IFF/transponder client families; older gates/overview are outside this scope."
    },
    "heat_temperature": {
      "label": "Frontier heat / temperature",
      "scope": "Frontier temperature/heat-zone consumer; generic EVE module-overheat mechanics are outside this feature column.",
      "qualification": "Present2884873, absent2898485, present2973163 onward; the branch gap must not be filled monotonically."
    },
    "industry_manufacturing": {
      "label": "Industry / manufacturing client",
      "scope": "Any audited station/constructables, manufacturer-service or later facility-production client generation. C does not mean every generation has the same catalogs/API.",
      "qualification": "Client job UI/services are present in every snapshot, including when its static cache is incomplete."
    },
    "lagrange_occupancy": {
      "label": "Lagrange occupancy",
      "scope": "Frontier Lagrange occupancy client/service, not generic inherited entosis occupancy calculations.",
      "qualification": "Same2884873/2898485 branch gap as heat; entosis/occupancyCalculator alone is not evidence for this system."
    },
    "magnetic_docking": {
      "label": "Docking points/refuel",
      "scope": "Magnetic manual docking-point capabilities/dock/restore/refuel, excluding legacy station docking and SmartHangar berthing."
    },
    "manual_flight_integration": {
      "label": "Audited manual-flight integration",
      "scope": "Named legacy eve/.../shipNavigation integration/service or later Frontier navigation integration. This is not a claim that basic EVE/native flight was unavailable before these paths."
    },
    "medical_status": {
      "label": "Frontier medical traits / status client",
      "scope": "Dedicated status-effect client and Frontier shell medical-trait definitions. Generic dogma/effects and older heat are different audited systems."
    },
    "race_track": {
      "label": "Race-track prototype",
      "scope": "Frontier race-track prototype controller/UI; generic demo tools are excluded."
    },
    "relay_lens_wrapper": {
      "label": "Relay-lens messenger",
      "scope": "Dedicated public prepare/execute relay-lens messenger wrapper in trader; separate from the older trading UI."
    },
    "resolved_universe": {
      "label": "Resolved exploration",
      "scope": "Per-player known-universe/system-detail hydration and Universe-v1 schema14 client, excluding old static maps and explorationscanner helpers."
    },
    "smart_depot_assembly": {
      "label": "Smart depot / assembly client",
      "scope": "Concrete blockchain-depot inventory/state/configuration UI, signed smart-storage online/offline service, or smart-assembly client service. This is not a claim that all builds have every later assembly/deployment capability.",
