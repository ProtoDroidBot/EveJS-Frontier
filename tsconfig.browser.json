{
  "compilerOptions": {
    "target": "ES2022",
    "module": "None",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": false,
    "allowJs": false,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/browser.tsbuildinfo"
  },
  "include": ["tools/NewEdenStoreEditor/public/**/*.ts"]
}
