{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": false,
    "allowJs": false,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/server.tsbuildinfo"
  },
  "include": ["server/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/target",
    "_local",
    "server/tests"
  ]
}
