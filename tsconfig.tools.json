{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tools.tsbuildinfo"
  },
  "include": [
    "tools/**/*.ts",
    "tools/**/*.mts",
    "scripts/**/*.ts",
    "docker/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/target",
    "_local",
    "tools/NewEdenStoreEditor/public",
    "tools/EveOnlineImporter/bundles"
  ]
}
