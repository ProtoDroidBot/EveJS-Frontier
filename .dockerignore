# The build needs these application and TypeScript source trees. Keeping the context
# explicit prevents large local caches, logs, generated data, and test stores
# from being sent to the Linux Docker builder.
**
!Dockerfile
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.browser.json
!tsconfig.tools.json
!evejs.config.local.json
!npc-behavior.config.json
!frontier-dungeon-spawns.json
!frontier-dungeon-loot.json
!frontier-landscape-spawns.json
!server/
!server/**
!tools/
!tools/**
!scripts/
!scripts/**
!externalservices/
!externalservices/market-server/
!externalservices/market-server/**
!docker/
!docker/**

**/node_modules
**/node_modules/**
**/target
**/target/**
**/__pycache__
**/*.py[cod]
tools/ClientCodeGrabber/Latest
tools/ClientCodeGrabber/Latest/**
tools/ClientCodeGrabberV2
tools/ClientCodeGrabberV2/**
tools/ConfigEditor/assets
tools/ConfigEditor/assets/**
tools/DataSync/source_json
tools/DataSync/source_json/**
tools/PlayerConnect
tools/PlayerConnect/**
tools/PlayerConnect-v2
tools/PlayerConnect-v2/**
# JavaScript is generated from the TypeScript sources inside the builder.
**/*.js
**/*.mjs
**/*.js.map
**/*.mjs.map
server/logs
server/logs/**
server/tests
server/tests/**
server/src/logs
server/src/logs/**
server/src/_secondary/data/chat
server/src/_secondary/data/chat/**
server/src/_secondary/image/generated/Character
server/src/_secondary/image/generated/Character/**
server/src/gameStore/data/*/data.json
**/*.sqlite*
**/.env
**/.env.*
