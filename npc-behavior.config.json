{
  "schemaVersion": 2,
  "enabled": true,
  "defaults": {
    "role": "guard",
    "behaviorDefaults": {
      "thinkIntervalMs": 250,
      "autoAggroTargetClasses": [
        "player"
      ],
      "targetPreference": "preferredTargetThenNearestPlayer",
      "autoAggro": true,
      "movementMode": "orbit",
      "orbitDistanceMeters": 3500,
      "followRangeMeters": 2200,
      "aggressionRangeMeters": 150000,
      "leashRangeMeters": 250000,
      "returnToHomeWhenIdle": true,
      "homeArrivalMeters": 2000,
      "autoActivateWeapons": true,
      "passiveRoaming": true,
      "passiveWarping": true,
      "passiveRoamRadiusMeters": 750000,
      "passiveMoveMinDistanceMeters": 5000,
      "passiveMoveMaxDistanceMeters": 25000,
      "passiveMoveArrivalMeters": 750,
      "passiveMoveIntervalMinMs": 3000,
      "passiveMoveIntervalMaxMs": 12000,
      "passiveMoveTimeoutMs": 90000,
      "passiveWarpIntervalMs": 60000,
      "passiveWarpMinDistanceMeters": 175000,
      "passiveWarpMaxDistanceMeters": 650000
    }
  },
  "roles": {
    "guard": {
      "activity": "guard",
      "description": "Default combat role. Authored/SDE behavior remains authoritative; these values only fill missing fields.",
      "behaviorDefaults": {
        "chaseTargets": true,
        "mineAsteroids": false,
        "guardAnchor": true,
        "retainTargetLockWhenOccluded": false,
        "fireThroughOccluders": false
      }
    },
    "passive": {
      "activity": "idle",
      "description": "Non-combat traffic and utility hulls retain their authored passive behavior.",
      "behaviorDefaults": {
        "chaseTargets": false,
        "mineAsteroids": false,
        "guardAnchor": false,
        "retainTargetLockWhenOccluded": false,
        "fireThroughOccluders": false
      },
      "behaviorOverrides": {
        "autoAggro": false,
        "autoActivateWeapons": false
      }
    },
    "miner": {
      "activity": "mining",
      "description": "Mining-capable hulls are automatically enrolled in the mining controller and mine available local resources.",
      "behaviorDefaults": {
        "chaseTargets": false,
        "mineAsteroids": true,
        "guardAnchor": false,
        "retainTargetLockWhenOccluded": false,
        "fireThroughOccluders": false
      },
      "behaviorOverrides": {
        "autoAggro": false,
        "autoAggroTargetClasses": [],
        "targetPreference": "none",
        "autoActivateWeapons": false,
        "movementMode": "orbit",
        "orbitDistanceMeters": 1200,
        "followRangeMeters": 800
      },
      "activityOptions": {
        "autoEnroll": true
      }
    },
    "hauler": {
      "activity": "hauling",
      "description": "Mining-operation haulers remain passive and can be attached to configured mining fleets.",
      "behaviorDefaults": {
        "chaseTargets": false,
        "mineAsteroids": false,
        "guardAnchor": false,
        "retainTargetLockWhenOccluded": false,
        "fireThroughOccluders": false
      },
      "behaviorOverrides": {
        "autoAggro": false,
        "autoAggroTargetClasses": [],
        "targetPreference": "none",
        "autoActivateWeapons": false,
        "movementMode": "stop"
      },
      "activityOptions": {
        "autoEnroll": true
      }
    }
  },
  "rules": [
    {
      "id": "all-profiled-npc-roamers",
      "priority": 10,
      "match": {
        "all": true
      },
      "behaviorOverrides": {
        "passiveRoaming": true,
        "passiveWarping": true
      }
    },
    {
      "id": "authored-passive-npcs",
      "priority": 100,
      "match": {
        "behaviorAutoAggro": false
      },
      "role": "passive"
    },
    {
      "id": "ore-mining-hulls",
      "priority": 200,
      "match": {
        "profileIDPrefixes": [
          "ore_mining_"
        ],
        "loadoutIDPrefixes": [
          "ore_mining_"
        ],
        "excludeProfileIDContains": [
          "hauler"
        ]
      },
      "role": "miner"
    },
    {
      "id": "ore-mining-haulers",
      "priority": 210,
      "match": {
        "profileIDPrefixes": [
          "ore_mining_"
        ],
        "profileIDContains": [
          "hauler"
        ]
      },
      "role": "hauler"
    },
    {
      "id": "mining-response-guards",
      "priority": 220,
      "match": {
        "behaviorProfileIDs": [
          "npc_mining_response_fleet"
        ]
      },
      "role": "guard"
    }
  ]
}
